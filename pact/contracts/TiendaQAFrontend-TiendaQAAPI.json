{
  "consumer": {
    "name": "TiendaQAFrontend"
  },
  "interactions": [
    {
      "description": "una solicitud para consultar el catalogo",
      "providerStates": [
        {
          "name": "existen productos disponibles en el catalogo"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/productos"
      },
      "response": {
        "body": [
          {
            "activo": true,
            "categoria": "electronica",
            "id": 1,
            "nombre": "Computador portatil",
            "precio": 356.08,
            "stock": 36
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].activo": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].categoria": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[*].nombre": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].precio": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$[*].stock": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "una solicitud para consultar el detalle del producto",
      "providerStates": [
        {
          "name": "existe el producto con id 1"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/productos/1"
      },
      "response": {
        "body": {
          "activo": true,
          "categoria": "electronica",
          "descripcion": "Dispositivo electronico diseñado para uso personal y profesional.",
          "id": 1,
          "nombre": "Computador portatil",
          "precio": 356.08,
          "stock": 36
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.activo": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.categoria": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.descripcion": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.nombre": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.precio": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.stock": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "TiendaQAAPI"
  }
}